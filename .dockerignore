# Node modules (but keep package.json and package-lock.json)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Explicitly keep these files
!package.json
!package-lock.json

# Build outputs (will be created during build)
.local
dist
build

# Development files
.git
.gitignore
README.md
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github

# Logs
logs
*.log

# Coverage directory used by tools like istanbul
coverage

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity